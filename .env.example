ADMIN_PASSWORD=auntyhong-demo
DEMO_PAYMENTS=1
# On Vercel the kitchen desk uses Blob (OIDC or a runtime token). Do not rely on a build-time BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=
# DESK_PATH=data/desk.json

# Stripe TEST mode only (sk_test_ / pk_test_). Live keys are ignored by the app.
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook URL: https://<host>/api/stripe/webhook
# Events: payment_intent.succeeded, checkout.session.completed (legacy)
# Card pay uses embedded Payment Element on /pay/[orderId] — no Checkout redirect.
# Apple Pay domain verify is a Stripe Dashboard step if wallets do not appear.

# Order confirmation email (optional). Payment never fails if mail is unset.
# RESEND_API_KEY=
# RESEND_FROM=Aunty Hong Demo <orders@example.com>
# Or SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Aunty Hong Demo <orders@example.com>
# MAIL_FROM=
# NEXT_PUBLIC_SITE_URL=https://auntyhong-web.vercel.app
